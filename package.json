{
  "name": "projectlens",
  "version": "0.1.0",
  "description": "读取本地项目，自动生成面试问题、答案与追问，支持专业名词点词解释",
  "main": "out/main/index.js",
  "author": "ProjectLens",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:security": "npm run build && node --test --experimental-strip-types tests/security.test.mjs electron/services/sensitive.test.ts electron/services/security-integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:ipc": "node --experimental-strip-types --test electron/services/ipc-validation.test.ts electron/services/ipc-authority.test.ts electron/services/ipc-handler-guards.test.ts electron/services/llm-safe-results.test.ts",
    "test:scan-cache": "node --test --experimental-strip-types electron/services/project-snapshot.test.ts electron/services/scan-cache.test.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "ignore": "^5.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
